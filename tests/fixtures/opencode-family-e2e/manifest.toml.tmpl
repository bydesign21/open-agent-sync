# Deterministic OW-011 gate fixture manifest. @@LOCAL_PLUGIN_PATH@@ is
# substituted by the gate script with the absolute path to
# tests/fixtures/opencode-family-e2e/local-plugin/agentsync-e2e-demo-plugin.ts.

# `hosts` is restricted to opencode/kilo: the synthetic hook-source host
# declares no [mcp] section at all (see host-descriptor.toml.tmpl), so an
# unrestricted entry would be reported as permanently, unfixably blocked
# there — real divergence the tool must report forever, not a convergence
# bug, but noise this gate does not need for its own purposes.
#
# THREE servers, not one: a live regression check for the N-server sync bug
# (batching N per-server `ConfigTransaction`s against the same guarded JSONC
# file, each stamped with the same plan-time hash, so only the first write
# ever survived and the rest failed with a spurious precondition mismatch).
# A single-server fixture could not have caught that class of bug, and this
# gate is what is supposed to catch it live going forward.
[mcp.agentsync-e2e-demo]
transport = "stdio"
command = "true"
args = ["--stdio"]
scope = "user"
hosts = ["opencode", "kilo"]

[mcp.agentsync-e2e-demo-2]
transport = "stdio"
command = "true"
args = ["--stdio", "--second"]
scope = "user"
hosts = ["opencode", "kilo"]

[mcp.agentsync-e2e-demo-3]
transport = "stdio"
command = "true"
args = ["--stdio", "--third"]
scope = "user"
hosts = ["opencode", "kilo"]

[plugins.agentsync-e2e-demo-plugin.targets.opencode]
local = "@@LOCAL_PLUGIN_PATH@@"
scope = "user"

[plugins.agentsync-e2e-demo-plugin.targets.kilo]
local = "@@LOCAL_PLUGIN_PATH@@"
scope = "user"

# An env-referencing server. This exists because a real user run failed on
# exactly this shape: every MCP server holding an `{env:NAME}` reference was
# rejected during post-write verification, even when the variable WAS set,
# because the resolver context was never populated. Every fixture before this
# one used plain servers, so the whole class was invisible to the gate.
#
# The placeholder must survive VERBATIM in the written config — the host
# resolves it at runtime. agentsync must never expand a secret into the file,
# and must never turn an unset variable into an empty string.
[mcp.agentsync-e2e-env-ref]
transport = "http"
url = "https://example.invalid/mcp"
bearer_token_env = "AGENTSYNC_E2E_FAKE_TOKEN"
scope = "user"
